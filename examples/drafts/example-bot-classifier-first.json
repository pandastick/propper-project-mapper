{
  "pipeline": "inbound",
  "name": "classifier-first",
  "addNodes": [
    {
      "id": "intent-classifier",
      "name": "Intent classifier",
      "kind": "classifier",
      "lane": "door",
      "assume": { "latencyMs": 350, "decision": "intent", "split": { "chat": 0.7, "command": 0.3 } }
    }
  ],
  "removeEdges": [{ "from": "dedupe", "to": "mode-gate" }],
  "addEdges": [
    { "from": "dedupe", "to": "intent-classifier", "when": { "decision": "duplicate", "equals": "no" } },
    { "from": "intent-classifier", "to": "mode-gate" }
  ],
  "changeEdges": [{ "from": "fast-path", "to": "command-reply", "when": { "decision": "intent", "equals": "command" } }]
}
