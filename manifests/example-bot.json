{
  "id": "example-bot",
  "name": "Example Bot",
  "description": "Synthetic chat bot that shows the Pipeline view. Not a real system.",
  "tech": "Node.js (synthetic)",
  "sections": [],
  "screens": [],
  "entities": [],
  "relationships": [],
  "flows": [],
  "pipelines": [
    {
      "id": "inbound",
      "name": "A message reaches the bot",
      "description": "From the chat platform to the reply, with modes and a fast path.",
      "lanes": [
        "door",
        "brain",
        "after"
      ],
      "laneNotes": {
        "door": "Takes the update, drops repeats.",
        "brain": "Picks who answers, then answers.",
        "after": "Sends the reply."
      },
      "entry": "receive",
      "nodes": [
        {
          "id": "receive",
          "name": "Receive update",
          "description": "Takes each update from the chat platform and hands it on.",
          "kind": "door",
          "lane": "door",
          "owner": "example",
          "anchor": {
            "repo": "example",
            "path": "src/door.js",
            "symbol": "receiveUpdate"
          }
        },
        {
          "id": "dedupe",
          "name": "Drop duplicates",
          "description": "Drops an update the bot has already seen, so a retry never answers twice.",
          "kind": "gate",
          "lane": "door",
          "decides": "duplicate",
          "owner": "example",
          "anchor": {
            "repo": "example",
            "path": "src/door.js",
            "symbol": "isDuplicate"
          }
        },
        {
          "id": "mode-gate",
          "name": "Which mode is on",
          "description": "Reads which mode the person has switched on and sends the message that way.",
          "kind": "mode",
          "lane": "door",
          "decides": "mode",
          "values": ["normal", "planner", "privacy"],
          "owner": "example",
          "anchor": {
            "repo": "example",
            "path": "src/modes.js",
            "symbol": "currentMode"
          }
        },
        {
          "id": "planner-hold",
          "name": "Hold for planner",
          "description": "While planner mode is on, the message waits here for the next planning round.",
          "kind": "queue",
          "lane": "brain",
          "owner": "example",
          "anchor": {
            "repo": "example",
            "path": "src/modes.js",
            "symbol": "holdForPlanner"
          }
        },
        {
          "id": "private-model",
          "name": "Private model",
          "description": "Answers with a model that keeps the text off the main agent.",
          "kind": "model",
          "lane": "brain",
          "owner": "example",
          "anchor": {
            "repo": "example",
            "path": "src/agent.js",
            "symbol": "answerPrivately"
          }
        },
        {
          "id": "fast-path",
          "name": "Command or chat",
          "description": "A slash command takes the short way; everything else goes to the agent.",
          "kind": "router",
          "lane": "brain",
          "decides": "fast",
          "owner": "example",
          "anchor": {
            "repo": "example",
            "path": "src/router.js",
            "symbol": "fastPath"
          }
        },
        {
          "id": "command-reply",
          "name": "Run the command",
          "description": "Runs the command and writes its answer. No model.",
          "kind": "tool",
          "lane": "brain",
          "owner": "example",
          "anchor": {
            "repo": "example",
            "path": "src/router.js",
            "symbol": "replyToCommand"
          }
        },
        {
          "id": "agent",
          "name": "Agent",
          "description": "The main agent reads the message and writes the reply.",
          "kind": "model",
          "lane": "brain",
          "owner": "example",
          "anchor": {
            "repo": "example",
            "path": "src/agent.js",
            "symbol": "runAgent"
          }
        },
        {
          "id": "reply",
          "name": "Send reply",
          "description": "Sends the reply back to the chat.",
          "kind": "sender",
          "lane": "after",
          "owner": "example",
          "anchor": {
            "repo": "example",
            "path": "src/send.js",
            "symbol": "sendReply"
          }
        }
      ],
      "edges": [
        {
          "from": "receive",
          "to": "dedupe"
        },
        {
          "from": "dedupe",
          "to": "mode-gate",
          "when": {
            "decision": "duplicate",
            "equals": "no"
          }
        },
        {
          "from": "mode-gate",
          "to": "planner-hold",
          "when": {
            "decision": "mode",
            "equals": "planner"
          }
        },
        {
          "from": "mode-gate",
          "to": "private-model",
          "when": {
            "decision": "mode",
            "equals": "privacy"
          }
        },
        {
          "from": "mode-gate",
          "to": "fast-path"
        },
        {
          "from": "fast-path",
          "to": "command-reply",
          "when": {
            "decision": "fast",
            "equals": "yes"
          }
        },
        {
          "from": "fast-path",
          "to": "agent"
        },
        {
          "from": "command-reply",
          "to": "reply"
        },
        {
          "from": "agent",
          "to": "reply"
        },
        {
          "from": "private-model",
          "to": "reply"
        }
      ],
      "channel": "Telegram"
    }
  ]
}
